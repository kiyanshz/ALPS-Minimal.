<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/bg_wallpaper" android:orientation="horizontal">
 <LinearLayout android:layout_width="104dp" android:layout_height="match_parent"
  android:background="@drawable/bg_dock" android:gravity="center_horizontal"
  android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
  <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="@color/cp_text" android:textSize="22sp" android:textStyle="bold"/>
  <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:format12Hour="EEE d MMM" android:format24Hour="EEE d MMM" android:textColor="@color/cp_text_dim" android:textSize="12sp"/>
  <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  <ImageView android:id="@+id/dockMaps" android:layout_width="68dp" android:layout_height="68dp"
   android:background="@drawable/bg_dock_button" android:padding="16dp" android:src="@android:drawable/ic_menu_mapmode"
   android:contentDescription="Maps" android:clickable="true" android:focusable="true"/>
  <ImageView android:id="@+id/dockMusic" android:layout_width="68dp" android:layout_height="68dp"
   android:layout_marginTop="14dp" android:background="@drawable/bg_dock_button" android:padding="16dp"
   android:src="@android:drawable/ic_media_play" android:contentDescription="Music" android:clickable="true" android:focusable="true"/>
  <ImageView android:id="@+id/dockPhone" android:layout_width="68dp" android:layout_height="68dp"
   android:layout_marginTop="14dp" android:background="@drawable/bg_dock_button" android:padding="16dp"
   android:src="@android:drawable/ic_menu_call" android:contentDescription="Phone" android:clickable="true" android:focusable="true"/>
  <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  <ImageView android:id="@+id/dockSettings" android:layout_width="68dp" android:layout_height="68dp"
   android:background="@drawable/bg_dock_button" android:padding="16dp" android:src="@android:drawable/ic_menu_preferences"
   android:contentDescription="Settings" android:clickable="true" android:focusable="true"/>
 </LinearLayout>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/appGrid" android:layout_width="0dp"
  android:layout_height="match_parent" android:layout_weight="1" android:clipToPadding="false"
  android:overScrollMode="never" android:padding="28dp"/>
</LinearLayout>