<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALPS"
                android:textColor="@color/cp_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR APPS"
                android:textColor="@color/cp_text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.18" />
        </LinearLayout>
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/cp_text"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>


    <EditText
        android:id="@+id/appSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_search"
        android:hint="جست‌وجوی برنامه‌ها"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#AFFFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/appEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="برنامه‌ای با این نام پیدا نشد"
        android:textColor="@color/cp_text_dim"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="12dp"
        android:paddingBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dock"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/dockHome"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="7dp"
            android:background="@drawable/bg_dock_button"
            android:padding="4dp"
            android:src="@drawable/ic_alps_launcher"
            android:contentDescription="Home"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />
        <ImageView
            android:id="@+id/dockMaps"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="7dp"
            android:background="@drawable/bg_dock_button"
            android:padding="14dp"
            android:src="@drawable/ios26_lg_maps"
            android:contentDescription="Maps"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />
        <ImageView
            android:id="@+id/dockMusic"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="7dp"
            android:background="@drawable/bg_dock_button"
            android:padding="14dp"
            android:src="@drawable/ios26_lg_music"
            android:contentDescription="Music"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />
        <ImageView
            android:id="@+id/dockPhone"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="7dp"
            android:background="@drawable/bg_dock_button"
            android:padding="14dp"
            android:src="@drawable/ios26_lg_phone"
            android:contentDescription="Phone"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />
        <ImageView
            android:id="@+id/dockSettings"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="7dp"
            android:background="@drawable/bg_dock_button"
            android:padding="14dp"
            android:src="@drawable/ios26_lg_settings"
            android:contentDescription="Settings"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>