<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <!-- Persistent CarPlay-style navigation rail -->
    <LinearLayout
        android:layout_width="66dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dock"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/dockHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_dock_button"
            android:padding="5dp"
            android:src="@drawable/ic_alps_launcher"
            android:contentDescription="Home"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/dockMaps"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_dock_button"
            android:padding="11dp"
            android:src="@drawable/ios26_lg_maps"
            android:contentDescription="Maps"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/dockMusic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_dock_button"
            android:padding="11dp"
            android:src="@drawable/ios26_lg_music"
            android:contentDescription="Music"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/dockPhone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_dock_button"
            android:padding="11dp"
            android:src="@drawable/ios26_lg_phone"
            android:contentDescription="Phone"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/dockSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_dock_button"
            android:padding="11dp"
            android:src="@drawable/ios26_lg_settings"
            android:contentDescription="Settings"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALPS"
                    android:textColor="@color/cp_text"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR APPS"
                    android:textColor="@color/cp_text_dim"
                    android:textSize="9sp"
                    android:letterSpacing="0.18" />
            </LinearLayout>
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/cp_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/appSearch"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_search"
            android:hint="Search apps"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#AFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/appEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No apps found"
            android:textColor="@color/cp_text_dim"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</LinearLayout>